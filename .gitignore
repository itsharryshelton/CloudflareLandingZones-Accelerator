# ---- Terraform ----
# Local provider/module install dirs
**/.terraform/*

# Keep the dependency lock file (commit it) but ignore the plugin cache
!**/.terraform.lock.hcl

# State files - MUST never be committed (contain resource data / secrets).
#
# State is local in this repository: every layer writes terraform.tfstate into
# its own directory. These rules are the only thing between that file and a
# commit, so do not relax them.
*.tfstate
*.tfstate.*
*.tfstate.backup
.terraform.tfstate.lock.info

# Crash logs
crash.log
crash.*.log

# ---- Variable files ----
# Default-deny. Variable files are the most likely place for a customer
# identifier or a pasted secret to end up, so nothing is committable unless
# listed below.
*.tfvars
*.tfvars.json
!*.tfvars.example

# Exceptions: the per-layer baselines and the deployment's config directory.
#
# The layer defaults are customer-agnostic - no account IDs, no customer names.
# The config directory DOES carry an account ID and domains once it is filled
# in: those are configuration, not secrets, but they are a customer's, so only
# commit them to a private repository. Credentials are never in either - the
# Cloudflare credential and every TF_VAR_ secret arrive from the environment at
# run time. Review any change to these files with that distinction in mind.
!deployment/layers/*/defaults.auto.tfvars
!deployment/config/*.tfvars

# Operator-local overrides: never committable, anywhere.
# Re-stated after the exceptions above so no negation can reach them.
**/local.auto.tfvars
**/terraform.tfvars
**/*.local.tfvars
**/*.auto.tfvars.json

# CLI config / credentials
.terraformrc
terraform.rc
.env
.env.*

# Override files (local-only experiments)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Saved plans
#
# A plan file holds resolved zone IDs, DNS record contents, full WAF rule
# expressions and any TF_VAR_ secret the layer was given - treat it like state.
*.tfplan
tfplan
tfplan.json

# ---- Script leftovers ----
# One wrangler config per D1 database, generated by scripts/d1-migrations.sh
# from the IDs in state and deleted straight after. It has to be written inside
# the layer because wrangler resolves migrations_dir against the config's own
# directory.
**/.d1-migrations-*.json
__pycache__/
